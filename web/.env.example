# loculus signs in through pistis, the aether-zone authorization server. There
# is no account store here — these values register the console as an OAuth
# client of it. Copy this file to `web/.env` and fill in the secret.
#
# The client has to exist in pistis first, with this exact redirect URI. Objects
# belong to the OAuth *client* that presigned them, so the console sees what it
# uploaded and not, say, what akouo did — this is `loculus`'s own client, not a
# borrowed one.

# The pistis API: mints the tokens, publishes the keys the loculus api checks
# them against. Must match the `iss` claim exactly.
OAUTH_ISSUER=http://localhost:3001

# The pistis *web* app's consent screen. Not the same origin as the issuer:
# `GET /api/oauth/authorize` answers with JSON describing the pending request
# rather than redirecting, so a browser has to be sent to the app that renders
# the consent UI, not to the API.
OAUTH_CONSENT_URL=http://localhost:3002/login

OAUTH_CLIENT_ID=loculus
# Handed out once when the client is registered in pistis, and stored there only
# as a bcrypt hash — if it is lost it has to be rotated, not recovered.
OAUTH_CLIENT_SECRET=

# Must be registered against the client in pistis; it refuses any other value.
OAUTH_REDIRECT_URI=http://localhost:3112/api/auth/callback

# `profile` is what /oauth/userinfo requires to return a name at all. loculus
# knows nothing about organizations, so that scope is not asked for.
OAUTH_SCOPES=profile email organizations

# The loculus api, for server-side calls carrying the access token.
LOCULUS_API_URL=http://localhost:3111
