# Copy to .env. Organon loads .env.local first, then .env.

# --- Object store -----------------------------------------------------------
# The address the *browser* will use: every signed URL carries it, so an
# internal hostname works here and resolves nowhere for the client that has to
# spend the URL. Leave unset for real AWS.
# 9020, not MinIO's default 9000: that port is commonly taken (ClickHouse uses
# it). docker-compose.yml maps the container to match.
S3_ENDPOINT=http://localhost:9020
S3_BUCKET=loculus-objects
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# No defaults on purpose: a store reachable with a development password is one
# that is also reachable in production if nobody set these.
S3_ACCESS_KEY_ID=aether-zone
S3_SECRET_ACCESS_KEY=Ch4nG3M3!

# Seconds. Short, because a leaked upload URL is a write.
UPLOAD_URL_EXPIRES_IN=900
DOWNLOAD_URL_EXPIRES_IN=900
MAX_UPLOAD_BYTES=5368709120

# --- Objects ---------------------------------------------------------------
# loculus records a row per object so it knows whose it is, and whether the
# bytes ever arrived. Without it any valid token could read or delete any
# object whose key it had learned.
DATABASE_PATH=db.sqlite
DATABASE_SYNCHRONIZE=true

# --- Events ----------------------------------------------------------------
# The broker is SHARED with every other aether-zone service — one exchange is
# the only arrangement in which loculus events reach a consumer in akouo. In
# development that is the one akouo's compose file runs.
RABBITMQ_URI=amqp://aether-zone:Ch4nG3M3!@localhost:5682
RABBITMQ_EXCHANGE=aether-zone
# 0 starts without waiting for the broker.
RABBITMQ_CONNECT_TIMEOUT_MS=0

# --- Identity ---------------------------------------------------------------
# pistis's public origin. Must equal the `iss` claim of its tokens exactly.
OAUTH_ISSUER=http://localhost:3001
# Defaults to the issuer, which is what pistis defaults `aud` to.
# OAUTH_AUDIENCE=
# Derived from the issuer per RFC 8414 unless set.
# OAUTH_JWKS_URI=

# --- Process ----------------------------------------------------------------
PORT=3111
LOG_LEVEL=debug
